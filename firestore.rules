rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // DRIVERS COLLECTION
    // ============================================
    match /drivers/{driverId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == driverId
                    && isValidDriverData();

      allow update: if request.auth != null
                    && request.auth.uid == driverId
                    && isDriverUpdateAllowed();

      allow delete: if false;

      function isValidDriverData() {
        return request.resource.data.keys().hasAll([
          'name', 'phone', 'lat', 'lng', 'geohash', 'isOnline', 'credit'
        ])
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.geohash is string
        && request.resource.data.geohash.size() >= 5
        && request.resource.data.isOnline is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.credit is number
        && request.resource.data.credit >= 0;
      }

      function isDriverUpdateAllowed() {
        let allowedFields = [
          'lat', 'lng', 'geohash', 'isOnline', 'fcmToken',
          'lastUpdated', 'currentRideId'
        ];
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasOnly(allowedFields);
      }
    }

    // ============================================
    // RIDES COLLECTION
    // ============================================
    match /rides/{rideId} {
      allow read: if request.auth != null
                  && (
                    resource.data.assignedDriverId == request.auth.uid
                    || request.auth.uid in resource.data.notifiedDrivers
                  );

      allow create: if false;

      allow update: if request.auth != null
                    && isRideUpdateValid();

      allow delete: if false;

      function isRideUpdateValid() {
        let allowedStatusTransitions = {
          'pending': ['accepted', 'no_drivers', 'expired'],
          'accepted': ['in_progress', 'cancelled'],
          'in_progress': ['completed', 'cancelled'],
          'completed': [],
          'cancelled': [],
          'no_drivers': [],
          'expired': []
        };

        let currentStatus = resource.data.status;
        let newStatus = request.resource.data.status;
        let validTransitions = allowedStatusTransitions[currentStatus];
        let statusChangeAllowed = newStatus in validTransitions;

        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let fieldsAllowed = changedKeys.hasOnly([
          'status', 'assignedDriverId', 'acceptedAt',
          'startedAt', 'completedAt', 'notifiedDrivers',
          'notificationSentAt', 'fare'
        ]);

        return fieldsAllowed && statusChangeAllowed;
      }
    }

    // ============================================
    // ADMINS COLLECTION
    // ============================================
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // ============================================
    // CUSTOMERS COLLECTION
    // ============================================
    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.uid == customerId;
    }
  }
}
