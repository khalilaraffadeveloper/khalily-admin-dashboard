rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isDriverOwner() {
      return (resource.data.get("authUid") != null && resource.data.authUid == request.auth.uid)
          || (resource.data.get("authUid") == null && request.resource.data.authUid == request.auth.uid);
    }

    function isCustomerOwner() {
      return (resource.data.get("authUid") != null && resource.data.authUid == request.auth.uid)
          || (resource.data.get("authUid") == null && request.resource.data.authUid == request.auth.uid);
    }

    match /drivers/{driverId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isDriverOwner() || isAdmin());
      allow delete: if false;
    }

    match /rides/{rideId} {
      allow read: if true;
      allow create: if false;
      allow update: if request.auth != null && (
        resource.data.assignedDriverId == request.auth.uid
        || isAdmin()
      ) && isRideUpdateValid();
      allow delete: if false;

      function isRideUpdateValid() {
        let allowed = {
          'pending': ['accepted', 'no_drivers', 'expired'],
          'accepted': ['in_progress', 'cancelled'],
          'in_progress': ['completed', 'cancelled'],
          'completed': [], 'cancelled': [],
          'no_drivers': [], 'expired': []
        };
        return request.resource.data.status in allowed[resource.data.status];
      }
    }

    match /customers/{customerId} {
      allow read: if true;
      allow write: if request.auth != null && (isCustomerOwner() || isAdmin());
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
